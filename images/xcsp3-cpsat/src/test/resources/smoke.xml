<instance format="XCSP3" type="COP">
  <variables>
    <array id="x" size="[4]">0..3</array>
    <var id="b">0..1</var>
  </variables>
  <constraints>
    <allDifferent>x[]</allDifferent>
    <intension>iff(b,lt(x[0],x[1]))</intension>
    <extension><list>x[2] x[3]</list><conflicts>(0,*)(1,2)</conflicts></extension>
    <sum><list>x[0] x[3]</list><coeffs>2 1</coeffs><condition>(le,7)</condition></sum>
    <element><list>x[]</list><index>x[3]</index><value>2</value></element>
  </constraints>
  <objectives>
    <maximize type="sum"><list>x[] b</list><coeffs>8 4 2 1 3</coeffs></maximize>
  </objectives>
</instance>
