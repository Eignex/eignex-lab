# Copied to ~/.config/eignex-lab/lab.env by install.sh, which writes these settings into both services; rerun it
# after a change. Every setting has a default. Quote values that contain spaces; keep comments on their own lines.

# The JDK the services and klause builds run on. Default: the JDK 25 the Gradle toolchain provisions.
#JAVA_HOME=/path/to/jdk-25
# The database, worktrees and the lab's Gradle home; keep it on the internal SSD. Default: ~/eignex-lab-data
#LAB_DATA=/path/to/eignex-lab-data
# Legacy Klause source URL; only this canonical Eignex URL is accepted. Other repos use the job's repository field.
#LAB_REPO=https://github.com/Eignex/klause.git
# Each job's files, the bulk of the lab's data. Default: $LAB_DATA/jobs. It and the corpus may live on an external
# drive (see External drive in SETUP.md), such as /Volumes/Ros/eignex-lab/jobs. A path under /Volumes needs its volume
# mounted: until it is, the lab holds its queue and creates nothing there. The services start without a login, so the
# drive must mount without one too:
#   sudo defaults write /Library/Preferences/SystemConfiguration/autodiskmount AutomountDisksWithoutUserLogin -bool true
#LAB_JOBS=/Volumes/Ros/eignex-lab/jobs
# The benchmark instances. Default: ~/.cache/klause-bench/corpus
#LAB_CORPUS=/Volumes/Ros/klause-bench/corpus
#LAB_PORT=8420
#LAB_GRADLE_WORKERS=2
# JVM flags for each solve; the lab adds -XX:ActiveProcessorCount for the case's cores.
#LAB_SOLVE_JAVA_OPTS="-Xmx3g -XX:+UseSerialGC"
# The most cases one experiment runs at once, and its default; each holds a solve heap, so memory bounds it.
#LAB_MAX_PARALLEL=6
# Cores the running cases may hold together, a case holding its arm's processors. Default: cores less two.
#LAB_CORES=8
# Worktree directories every job shares, separated by ':', each linked under $LAB_DATA/shared. None by default.
#LAB_SHARED_PATHS=
# Seconds between the runner's checks for a newer eignex-lab commit, applied between jobs; 0 turns it off.
#LAB_UPDATE_CHECK_SEC=300
# The runner holds the queue while any volume it writes to (LAB_DATA's, LAB_JOBS', LAB_CORPUS') has less than this many GB free.
#LAB_MIN_FREE_GB=10
# An ended job's bulk is trimmed this many days after it ended; longer, 90 say, when LAB_JOBS has a roomy drive of its own.
#LAB_TRIM_AGE_DAYS=7
# ...and sooner, largest first, while the job files' volume has less than this many GB free.
#LAB_JOBS_TARGET_FREE_GB=25
# A low disk leaves a job's files alone this many hours after it ended, so a fetch soon after finds them all...
#LAB_TRIM_GRACE_HOURS=6
# ...unless the job files' volume has less than this many GB free (default: LAB_MIN_FREE_GB). A held job is never trimmed.
#LAB_TRIM_CRITICAL_FREE_GB=10
# Docker for the containerised reference solvers: colima (macOS), system (Linux) or none.
# Default: colima when installed on macOS, system when docker is installed on Linux, else none.
#LAB_DOCKER=colima
# Days between the runner's Docker cleanups (sooner on a low disk); 0 turns the automatic cleanup off.
#LAB_DOCKER_CLEANUP_DAYS=7
# Reference image tags a cleanup keeps; the other tags of their repositories go, besides latest.
#LAB_DOCKER_KEEP=klause-xcsp3-cpsat:source-preserving-v2,klause-scip:latest,klause-clasp:latest
# Directories put in front of the services' fixed PATH.
#LAB_PATH=/opt/minizinc/bin
# Reference solver binaries, when not the ones on PATH; z3's memory cap in MB. The algebraic SMT-LIB checker uses the same z3.
#LAB_Z3=/opt/homebrew/bin/z3
#LAB_Z3_MEMORY_MB=2048
#LAB_CVC5=
#LAB_KISSAT=
#LAB_HIGHS=
# The launcher reference cases run. Default: $LAB_DATA/releases/current/bin/eignex-lab.
#LAB_LAUNCHER=
