#!/usr/bin/env bash
# Client for the eignex lab server. Defaults to https://lab.eignex.com; LAB_URL overrides the API address.
# Consuming-repository agents use this HTTP client; server access belongs to eignex-lab operations.
# Auto placement is preferred and is the default for ordinary jobs: omit tags.
# The lab uses idle local capacity and adds cloud capacity with demand, respecting job priority.
# Each workload/seed/repetition row runs all arms on the same machine in one attempt.
# Different rows and preparation can use different machines; ordinary A/B jobs need no machine pin.
#   lab run [--tags expr --measurement mode] <experiment.json> queue an experiment: problems × configs × seeds, one case each
#                                                            one per question over all its problems, never batches; follow it with lab wait, lab cases
#   lab profile [--tags expr --timeout sec --repo Eignex/name --build task --classpath path] <main> <ref> <description> -- [arg...]
#                                                            queue a committed JVM main from an Eignex repository
#                                                            run once with [arg...] in a build of <ref>, under JFR, locally
#                                                            or on a Spot cloud node unless tags request on-demand; the lab
#                                                            places jobs; for measurements experiments
#                                                            cannot express, NOT for running tests, lint or other gates (CI
#                                                            runs those). <ref> must be main or a branch only trusted users
#                                                            pushed to. --timeout is its time limit in seconds: 600 (10 min) when
#                                                            empty or left out, capped at 7200 (2 h); at it the main gets
#                                                            SIGTERM, then SIGKILL 30 s later, so it should write results
#                                                            as it goes or flush them on shutdown
# Submission options: --tags 'arch:x86_64,simd:avx2,!spot' requires tags and excludes !tags; repeat or comma-separate.
# --measurement none|resources|jfr|compilation|compilation+log selects an experiment's CLI recording.
#   lab analyze <id>                                        queue an analysis job: the lab's compilation analyser rerun over the
#                                                            retained captures of an ended JFR-recorded job <id>, writing each case's
#                                                            compilation-report.json afresh; no build, no solver, no consumer code.
#                                                            Refused once the job was trimmed (LAB_TRIM_AGE_DAYS after it ended)
#   lab analyze --archive <name> --sha256 <hex> [--manifest <name>] [--manifest-sha256 <hex>]
#                                                            the same over a pinned saved-capture archive (a campaign-evidence
#                                                            .tar.gz, a path under $LAB_DATA/archives on the lab; never a URL)
#                                                            and its .manifest.json, once the job itself is gone; the archive is
#                                                            checked against its sha256 and verified before anything is extracted
#   lab recheck <id>                                        queue a recheck job: the lab's source checkers run again over ended
#                                                            job <id>'s stored records (the solution claims in the formats the
#                                                            lab checks), each verdict replacing the case's earlier one; no solver runs
#   lab cases <id>                                          an experiment's cases: status, arm, problem, result, host
#   lab journal                                             pending result bytes, age, capacity and drain errors
#   lab cases <id> --json                                   every case whole as JSON Lines, one per line: index, arm, seed,
#                                                            repeat, problem, status, host (local, or the cloud node's
#                                                            instance), labDebug (its historical debug setting, from the
#                                                            arm's debug) and the full record, its finalWitness and the
#                                                            lab's verdict (record.labCheck) included
#   lab csv <id> [arm] [seed]                               every case as CSV, or one arm's results as CSV
#   lab corpus-index <collection>                         stored-byte catalog metadata as JSON; no corpus download
#   lab references [--json] <text> [solver] [verdict]       find reference results; --json retains all metadata
#                                                            verdict: optimum unproven satisfied infeasible unknown
#   lab references retire <collection> <solver> [budget-sec]
#                                                            retire a solver's reference rows on a collection, only those
#                                                            of that budget when given: kept as history, left out of
#                                                            comparisons and coverage, missing to "reference": "missing"
#                                                            selections, and replaced by the solver's next row on each
#                                                            problem whatever its budget. Prints how many rows it retired
#   lab compare <id> <id>...                                the address of a page comparing experiments side by side
#   lab vcpus <id> <n>                                       dedicate n vCPUs to a job, also while it runs: each worker
#                                                            runs n-1 cases at once (one if n is 1) and its preparation
#                                                            builds with them; `lab parallel` is the retired name
#   lab priority <id> <n>                                    reorder a queued job; a running one yields to a higher one
#   lab pause <id> | lab resume <id>                         hold a job; a running one stops between its commands
#   lab wait <id>...                                         block until every job given has ended; prints each end
#   lab schedule <name> <ref> <experiment.json> <interval-sec>   rerun the experiment on every new commit of <ref>
#   lab reschedule <id> <experiment.json|-> [interval-sec|-] [next-in-hours]
#                                                            change a schedule's experiment, interval or next check
#   lab schedules | lab unschedule <id>
#   lab check <id>                                          check a schedule's ref now instead of at its next interval
#   lab launch <id>                                         queue a schedule's run now, even if its ref has not moved
#   lab execution <id>                                   Nomad session, allocation, generation and phase diagnostics
#   lab capacity [show|leases|request <pool> <nodes> [ttl-sec]|release <lease>]
#                                                        provider-neutral shared capacity; requests expire within one hour
#   lab ls [n]                                              every queued and running job, however old, then the newest n (30)
#   lab show <id> | lab cancel <id> | lab tail <id> [<n> [out|err]]
#                                                            show adds a queued job's placement and why it waits; cancel a
#                                                            wrong job, not a long one: the lab bounds runtime itself
#   lab placement [id] [--json]                              Nomad placement, node budgets and why queued jobs wait
#                                                            With an id, that job alone; --json prints GET /placement
#   lab update                                              update the lab now: between the running job's cases, not during one
#   lab docker-cleanup                                      prune old reference images and build cache now: between jobs
#   lab tags <id> [expr]                                    replace a queued, unadmitted job's tags; omit expr to clear them
#                                                            tags are comma-separated; ! excludes a capability
#                                                            empty tags restore auto; local-only is reserved for sweeps/references
#   lab describe <id> <text>                                 set or change what an experiment is for
#   lab retry <id>...                                       queue a failed or cancelled job again: its unfinished cases rerun
#   lab rm <id>...                                          delete ended jobs: their records, files and leftover worktrees
#   lab files <id> [--json]                                  list job files; JSON includes accepted archive SHA-256 hashes
#   lab cat <id> <path> [tail-bytes]                         print one of them (job.log, setup.log, cases/<n>/record.json…)
#   lab stdout <id> <n>                                      print case n's native solver stdout, cases/<n>/<name>.out, whole
#                                                            and as the solver wrote it, local or cloud; its size and sha256
#                                                            are the case's stdout in lab cases <id> --json
#   lab fetch <id> [dest]                                    download the job's output directory over HTTP, and its cases with
#                                                            their lab checks as lab-cases.jsonl (as lab cases --json). It
#                                                            holds the job first, so the lab's disk trim leaves its files
#                                                            alone, downloads the one listing it took, and releases the hold
#                                                            however it ends (a killed fetch's hold lapses after 2 h). A
#                                                            listed file it cannot download fails it: it fetches the rest,
#                                                            writes lab-fetch-missing.json naming each one, and exits 1
# The lab asks for its password on every call: LAB_PASSWORD, or ~/.config/eignex-lab/password.
set -euo pipefail
host="${LAB_HOST:-}"
url="${LAB_URL:-https://lab.eignex.com}"
if [[ -n "$host" && -z "${LAB_URL:-}" ]]; then url="http://$host:8420"; fi
# Every call carries the lab's password (HTTP Basic, no user name): LAB_PASSWORD, else the file LAB_PASSWORD_FILE,
# ~/.config/eignex-lab/password by default. It reaches curl through a private config file, never its command line.
password="${LAB_PASSWORD:-$(cat "${LAB_PASSWORD_FILE:-$HOME/.config/eignex-lab/password}" 2>/dev/null || true)}"
curl() {
  [[ -n "$password" ]] || { echo "no lab password: set LAB_PASSWORD or put it in ~/.config/eignex-lab/password" >&2; exit 2; }
  local auth status=0
  auth="$(umask 077; mktemp)"
  printf 'user = ":%s"\n' "$password" > "$auth"
  command curl -K "$auth" "$@" || status=$?
  rm -f "$auth"
  return "$status"
}
files_json() {
  local response code transport list_timeout="${LAB_FILE_LIST_TIMEOUT:-600}" deadline remaining wait_sec transport_timeout
  [[ "$list_timeout" =~ ^[0-9]{1,4}$ ]] && list_timeout=$((10#$list_timeout)) && [[ "$list_timeout" -le 3600 ]] ||
    { echo 'LAB_FILE_LIST_TIMEOUT must be 0 to 3600 seconds' >&2; return 2; }
  response=$(mktemp)
  deadline=$((SECONDS + list_timeout))
  while :; do
    transport=0
    remaining=$((deadline - SECONDS))
    # Leave transport margin, including one initial attempt when the overall retry budget is zero.
    wait_sec=$((remaining > 2 ? remaining - 2 : 1))
    (( wait_sec <= 30 )) || wait_sec=30
    transport_timeout=$((wait_sec + 2))
    code=$(curl -sS --max-time "$transport_timeout" -o "$response" -w '%{http_code}' "$url/jobs/$1/files?waitSec=$wait_sec") || transport=$?
    if [[ "$transport" -eq 0 && "$code" == 200 ]]; then cat "$response"; rm -f "$response"; return 0; fi
    if [[ "$transport" -ne 0 || "$code" != 503 || "$SECONDS" -ge "$deadline" ]]; then
      echo "lab: complete file inventory unavailable (HTTP $code)" >&2
      rm -f "$response"; return 1
    fi
    sleep 2
  done
}
data="${LAB_REMOTE_DATA:-eignex-lab-data}"
# The server's LAB_JOBS and LAB_CORPUS, relative to its home unless absolute, for lab corpus.
remote_jobs="${LAB_REMOTE_JOBS:-$data/jobs}"
remote_corpus="${LAB_REMOTE_CORPUS:-.cache/eignex-lab/corpus}"
corpus="${LAB_CORPUS:-$HOME/.cache/eignex-lab/corpus}"
node_tags='[]'
timeout='' measurement=''
# Shared submission options, kept separate from arguments passed to a committed main.
submission_option() {
  local expression parsed
  case "$1" in
    --tags)
      expression="${2:?--tags needs comma-separated tags, with ! before exclusions}"
      parsed="$(jq -cn --arg value "$expression" '
        $value | split(",") | map(gsub("^\\s+|\\s+$"; "")) |
        if any(.[]; test("^!?[a-z0-9][a-z0-9:._/-]*$") | not) then error("invalid node tag") else unique end')" || exit 2
      node_tags="$(jq -c --argjson added "$parsed" '. + $added | unique' <<< "$node_tags")" ;;
    --timeout)
      timeout="${2:?--timeout needs seconds}"
      [[ "$timeout" =~ ^[1-9][0-9]*$ ]] || { echo '--timeout must be a positive number of seconds' >&2; exit 2; } ;;
    *) return 1 ;;
  esac
}
submission_payload() {
  jq --argjson tags "$node_tags" --arg measurement "$measurement" --arg timeout "$timeout" '
    . + (if ($tags | length) == 0 then {} else {tags: (((.tags // []) + $tags) | unique)} end) +
      (if $measurement == "" then {} else {measurement: $measurement} end) |
    if $timeout == "" then . else .base = ((.base // {}) + {timeout: (($timeout | tonumber) * 1000 | tostring)}) end'
}
cmd="${1:-ls}"; shift || true
case "$cmd" in
journal) curl -fsS "$url/journal" | jq . ;;
run)
  while [[ $# -gt 0 ]]; do
    if submission_option "$@"; then shift 2; continue; fi
    case "$1" in
      --measurement) measurement="${2:?--measurement needs a recording mode}"; shift 2 ;;
      --) shift; break ;;
      -*) echo "unknown submission option: $1" >&2; exit 2 ;;
      *) break ;;
    esac
  done
  [[ $# -eq 1 ]] || { echo 'usage: lab run [--tags expr --measurement mode] <experiment.json>' >&2; exit 2; }
  submission_payload < "$1" | curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/experiments"; echo ;;
profile)
  repository=""
  build_tasks='[]' classpath='[]'
  while [[ $# -gt 0 ]]; do
    if submission_option "$@"; then shift 2; continue; fi
    case "$1" in
      --repo) repository="${2:?--repo needs Eignex/name}"; shift 2 ;;
      --build) build_tasks="$(jq -c --arg value "${2:?--build needs a Gradle task}" '. + [$value]' <<< "$build_tasks")"; shift 2 ;;
      --classpath) classpath="$(jq -c --arg value "${2:?--classpath needs a relative path}" '. + [$value]' <<< "$classpath")"; shift 2 ;;
      -*) echo "unknown profile option: $1" >&2; exit 2 ;;
      *) break ;;
    esac
  done
  [[ $# -ge 3 ]] || { echo 'usage: lab profile [--timeout sec] <main> <ref> <description> -- [arg...]' >&2; exit 2; }
  [[ -n "$repository" ]] || { echo "profile requires --repo Eignex/name and an explicit --classpath for JVM mains" >&2; exit 2; }
  main="$1" ref="$2" description="$3"
  shift 3
  [[ $# -eq 0 || "$1" == -- ]] || { echo 'profile arguments must follow --; set the limit with --timeout seconds' >&2; exit 2; }
  if [[ $# -gt 0 ]]; then shift; fi
  name="profile-$(echo "${main##*.}" | tr '[:upper:]' '[:lower:]')"
  # No timeout leaves the lab's default, 10 min; the lab caps any limit at 2 h.
  jq -n --arg name "$name" --arg main "$main" --arg ref "$ref" --arg description "$description" \
    --arg repository "$repository" --argjson buildTasks "$build_tasks" --argjson classpath "$classpath" --args \
    '{name: $name, repository: $repository, description: $description,
      profile: {main: $main, args: $ARGS.positional, buildTasks: $buildTasks, classpath: $classpath},
      base: {ref: $ref}}' -- "$@" | submission_payload |
    curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/experiments"; echo ;;
script) echo "lab script is retired: the lab runs only committed code; use lab profile <main> <ref> <description>" >&2; exit 2 ;;
analyze)
  usage="usage: lab analyze <job id> | lab analyze --archive <name under \$LAB_DATA/archives> --sha256 <hex> [--manifest <name>] [--manifest-sha256 <hex>]"
  if [[ "${1:-}" =~ ^[1-9][0-9]*$ && $# -eq 1 ]]; then
    jq -n --argjson job "$1" '{analyze: {job: $job, kind: "compilation"}}' |
      curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/experiments"; echo
  else
    archive="" sha="" manifest="" manifest_sha=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --archive) archive="${2:-}"; shift 2 ;;
        --sha256) sha="${2:-}"; shift 2 ;;
        --manifest) manifest="${2:-}"; shift 2 ;;
        --manifest-sha256) manifest_sha="${2:-}"; shift 2 ;;
        *) echo "$usage" >&2; exit 2 ;;
      esac
    done
    [[ -n "$archive" && "$sha" =~ ^[0-9a-f]{64}$ ]] || { echo "$usage" >&2; exit 2; }
    jq -n --arg archive "$archive" --arg sha "$sha" --arg manifest "$manifest" --arg manifest_sha "$manifest_sha" \
      '{analyze: ({kind: "compilation", archive: $archive, sha256: $sha}
        + (if $manifest == "" then {} else {manifest: $manifest} end)
        + (if $manifest_sha == "" then {} else {manifestSha256: $manifest_sha} end))}' |
      curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/experiments"; echo
  fi ;;
recheck)
  [[ "${1:-}" =~ ^[1-9][0-9]*$ && $# -eq 1 ]] || { echo "usage: lab recheck <job id>" >&2; exit 2; }
  jq -n --argjson job "$1" '{recheck: {job: $job}}' |
    curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/experiments"; echo ;;
cases)
  # --json prints JSON Lines: each case whole, one per line, streamed as the server reads them.
  if [[ "${1:-}" == --json ]]; then set -- "${2:-}" --json; fi
  [[ "${1:-}" =~ ^[1-9][0-9]*$ ]] || { echo "usage: lab cases <id> [--json]" >&2; exit 2; }
  if [[ "${2:-}" == --json ]]; then curl -fsS -N "$url/experiments/$1/cases.jsonl"
  else curl -fsS "$url/experiments/$1/cases" | jq -r '.[] | [.index, .status, .arm, (if .problem.suite == "" then .problem.problem else "\(.problem.suite)/\(.problem.problem)" end),
      (.seed // "-"), (if .record == null then "-" else
        "feasible=\(.record.feasible) objective=\(.record.objective) proven=\(.record.proven) best=\(.record.timeToBestMs)ms" end),
      (.host // "-")] | @tsv'; fi ;;
csv)
  if [[ -z "${2:-}" ]]; then curl -fsS "$url/experiments/$1/cases.csv"
  else curl -fsS -G "$url/experiments/$1/bench.csv" --data-urlencode "arm=$2" ${3:+--data-urlencode "seed=$3"}; fi ;;
references)
  if [[ "${1:-}" == retire ]]; then
    [[ -n "${2:-}" && -n "${3:-}" ]] || { echo "usage: lab references retire <collection> <solver> [budget-sec]" >&2; exit 2; }
    jq -n --arg collection "$2" --arg solver "$3" --arg budget "${4:-}" \
      '{collection: $collection, solver: $solver} + (if $budget == "" then {} else {budgetMs: (($budget | tonumber) * 1000)} end)' |
      curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/references/retire" | jq -r '"retired \(.retired) rows"'
    exit
  fi
  reference_format='.[] |
    [.collection, .problem, .reference.solver, (.reference.feasible|tostring), (.reference.objective|tostring),
     (.reference.proven|tostring), "\(.reference.elapsedMs)ms/\(.reference.budgetMs)ms"] | @tsv'
  if [[ "${1:-}" == --json ]]; then reference_format='.'; shift; fi
  [[ $# -ge 1 && $# -le 3 ]] || { echo 'usage: lab references [--json] <query> [solver] [verdict]' >&2; exit 2; }
  curl -fsS -G "$url/references" --data-urlencode "q=$1" --data-urlencode "solver=${2:-}" \
    --data-urlencode "verdict=${3:-}" -H 'Accept: application/json' | jq -r "$reference_format" ;;
ls)
  # Every active job first, newest first however old, then the newest n jobs that are not among them.
  { curl -fsS "$url/jobs?active=true"; curl -fsS "$url/jobs?limit=${1:-30}"; } | jq -s -r '
    (.[0] | sort_by(-.id)) as $active | ($active | map(.id)) as $ids
    | ($active + (.[1] | map(select(.id | IN($ids[]) | not))))[] | [.id, .status,
      "\(.counts.done)/\(.counts.total)", "\(.counts.failed) failed", "\(.vcpus // .parallel // 1) vCPU",
      "p\(.priority // 0)\(if .paused then " paused" else "" end)", .ref, .name] | @tsv' ;;
show)
  # A queued job comes with where it may run and why it waits (GET /placement/<id>).
  job=$(curl -fsS "$url/jobs/$1")
  if [[ "$(jq -r .status <<< "$job")" == QUEUED ]]; then
    placement=$(curl -fsS "$url/placement/$1") || placement=null
    jq --argjson p "$placement" '. + {placement: $p.placement, waiting: $p.waiting}' <<< "$job"
  else jq . <<< "$job"; fi ;;
execution) curl -fsS "$url/jobs/$1/execution" | jq . ;;
capacity)
  action="${1:-show}"; [[ $# -eq 0 ]] || shift
  case "$action" in
  show) curl -fsS "$url/capacity" | jq . ;;
  leases) curl -fsS "$url/capacity/leases" | jq . ;;
  request)
    [[ "${2:-}" =~ ^[1-9][0-9]*$ && "${3:-900}" =~ ^[1-9][0-9]*$ ]] || { echo "usage: lab capacity request <pool> <nodes> [ttl-sec]" >&2; exit 2; }
    jq -n --arg pool "$1" --argjson nodes "$2" --argjson ttl "${3:-900}" '{pool:$pool,nodes:$nodes,ttlSec:$ttl}' |
      curl -fsS -H 'Content-Type: application/json' -X POST --data-binary @- "$url/capacity/leases" | jq . ;;
  release) curl -fsS -X DELETE "$url/capacity/leases/$1" ;;
  *) echo "usage: lab capacity [show|leases|request|release]" >&2; exit 2 ;;
  esac ;;
placement)
  json=0 id=""
  for arg in "$@"; do case "$arg" in --json) json=1 ;; *) id="$arg" ;; esac; done
  [[ -z "$id" || "$id" =~ ^[1-9][0-9]*$ ]] || { echo "usage: lab placement [id] [--json]" >&2; exit 2; }
  # One decimal for core-hours and hours, as the queue page shows them.
  defs='def r1: (. * 10 | round) / 10;
    def est: if .estimate == null then "-" else "≈\(.estimate.coreHours | r1) core-h, \(.estimate.cases) cases, ~\(.estimate.localHours | r1) h locally (\(.estimate.note))" end;'
  if [[ -n "$id" ]]; then
    placement=$(curl -fsS "$url/placement/$id")
    if (( json )); then jq . <<< "$placement"
    else jq -r "$defs"'
      "\(.id) \(.name): \(.status), \(.placement), priority \(.priority)"
        + (if .queuePosition then ", #\(.queuePosition) in the queue" else "" end)
        + (if .localPosition then ", #\(.localPosition) in the local queue" else "" end),
      (if .estimate then "estimate: \(est)" else empty end),
      "vcpus: \(.vcpus // "-"); cases: \(.executingParallel // 0) executing / \(.requestedParallel // 1) requested; \(.pendingParallel // 0) awaiting allocation",
      (if .parallelismReason then "slots: \(.parallelismReason)" else empty end),
      (if .waiting then "waiting: \(.waiting)" else empty end),
      (if .doing then "doing: \(.doing)" else empty end),
      (if (.hosts // []) | length > 0 then "hosts: " + ([.hosts[] | "\(.host) \(.done) done, \(.running) running"] | join("; ")) else empty end)' <<< "$placement"; fi
  else
    report=$(curl -fsS "$url/placement")
    if (( json )); then jq . <<< "$report"
    else jq -r "$defs"'
      "cloud: \(.cloud // "no cloud settings")",
      (if .held then "local queue held: \(.held)" else empty end),
      (if .local == null then "local: free"
       else "local: job \(.local.id) \(.local.name): \(.local.doing)"
         + (if .local.stepSince then " (for \((.at - .local.stepSince) / 60000 | floor) min)" else "" end) end),
      (.jobs[] | [.id, .status, .placement, "p\(.priority)", (if .localPosition then "local #\(.localPosition)" else "-" end),
        est, (.waiting // .doing // "")] | @tsv)' <<< "$report"; fi
  fi ;;
cancel) curl -sS -X POST "$url/jobs/$1/cancel"; echo ;;
vcpus|parallel) jq -n --argjson vcpus "$2" '{vcpus: $vcpus}' |
  curl -sS -H 'Content-Type: application/json' --data-binary @- "$url/jobs/$1/vcpus"; echo ;;
priority) jq -n --argjson priority "$2" '{priority: $priority}' |
  curl -sS -H 'Content-Type: application/json' --data-binary @- "$url/jobs/$1/priority"; echo ;;
wait)
  for id in "$@"; do
    while :; do
      # The server holds the request until the job ends; a dropped connection is simply retried.
      status=$(curl -fsS --max-time 660 "$url/jobs/$id/wait?timeoutSec=600" | jq -r .status) || { sleep 10; continue; }
      case "$status" in DONE | FAILED | CANCELLED) echo -e "$id\t$status"; break ;; esac
    done
  done ;;
schedule)
  jq -n --arg name "$1" --arg ref "$2" --argjson interval "$4" --slurpfile experiment "$3" \
    '{name: $name, ref: $ref, intervalSec: $interval, experiment: $experiment[0]}' |
    curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/schedules"; echo ;;
reschedule)
  # `-` for the experiment or the interval keeps it; next-in-hours sets when the schedule is next checked.
  experiment=null; [[ "${2:--}" != - ]] && experiment=$(cat "$2")
  interval="${3:--}"; [[ "$interval" == - ]] && interval=null
  next=null; [[ -n "${4:-}" && "$4" != - ]] && next=$(awk -v h="$4" 'BEGIN { printf "%d", h * 3600 }')
  jq -n --argjson interval "$interval" --argjson experiment "$experiment" --argjson next "$next" \
    '{intervalSec: $interval, experiment: $experiment, nextCheckInSec: $next}' |
    curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/schedules/$1"; echo ;;
compare) echo "$url/compare?jobs=$(IFS=,; echo "$*")" ;;
schedules) curl -fsS "$url/schedules" | jq -r '.[] | [.id, .name, .ref, "every \(.intervalSec)s", "p\(.priority)",
      "last \(.lastSha // "-" | .[0:9]) job \(.lastJob // "-")"] | @tsv' ;;
check) curl -sS --fail-with-body -X POST "$url/schedules/$1/check"; echo ;;
launch) curl -sS -X POST "$url/schedules/$1/launch"; echo ;;
update) curl -sS -X POST "$url/update"; echo ;;
docker-cleanup) curl -sS -X POST "$url/docker-cleanup"; echo ;;
tags)
  [[ $# -ge 1 && $# -le 2 ]] || { echo 'usage: lab tags <id> [comma-separated tags]' >&2; exit 2; }
  [[ -z "${2:-}" ]] || submission_option --tags "$2"
  jq -n --argjson tags "$node_tags" '{tags: $tags}' |
    curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/jobs/$1/tags"; echo ;;
host|machines) echo "lab $cmd is retired: use lab tags <id> [comma-separated tags]; omit tags for auto placement" >&2; exit 2 ;;
describe) jq -n --arg description "${*:2}" '{description: $description}' |
  curl -sS -H 'Content-Type: application/json' --data-binary @- "$url/jobs/$1/description"; echo ;;
retry) for id in "$@"; do printf '%s\t' "$id"; curl -sS -X POST "$url/jobs/$id/retry"; echo; done ;;
rm) for id in "$@"; do printf '%s\t' "$id"; curl -sS -X POST "$url/jobs/$id/delete"; echo; done ;;
unschedule) curl -sS -X POST "$url/schedules/$1/delete"; echo ;;
pause) curl -sS -X POST "$url/jobs/$1/pause"; echo ;;
resume) curl -sS -X POST "$url/jobs/$1/resume"; echo ;;
tail)
  if [[ -z "${2:-}" ]]; then curl -fsS "$url/jobs/$1/files/job.log?tail=${TAIL_BYTES:-8000}"
  else curl -fsS "$url/jobs/$1/files/$2.${3:-out}?tail=${TAIL_BYTES:-8000}"; fi ;;
files)
  if [[ "${2:-}" == --json ]]; then files_json "$1"
  else files_json "$1" | jq -r '.[] | "\(.bytes)\t\(.path)"'; fi ;;
cat) curl -fsS "$url/jobs/$1/files/$2${3:+?tail=$3}" ;;
stdout)
  [[ "${1:-}" =~ ^[1-9][0-9]*$ && "${2:-}" =~ ^[0-9]+$ ]] || { echo "usage: lab stdout <id> <case>" >&2; exit 2; }
  # The case's .out files directly under cases/<n>/, each path's segments URL-encoded.
  paths=$(files_json "$1" | jq -r --arg dir "cases/$2/" \
    '.[].path | select(startswith($dir) and endswith(".out") and (ltrimstr($dir) | contains("/") | not)) | split("/") | map(@uri) | join("/")')
  [[ -n "$paths" ]] || { echo "lab stdout: job $1 case $2 has no native stdout file" >&2; exit 1; }
  while IFS= read -r path; do curl -fsS "$url/jobs/$1/files/$path"; done <<< "$paths" ;;
fetch)
  [[ "${1:-}" =~ ^[1-9][0-9]*$ ]] || { echo "usage: lab fetch <id> [dest]" >&2; exit 2; }
  id="$1" dest="${2:-lab-jobs/$1}"; mkdir -p "$dest"
  receipt="$dest/lab-fetch-missing.json" part="" missing="" verified=""
  # Take a hold before listing, renew it during the download, and release it on every exit.
  hold=$(curl -fsS -X POST "$url/jobs/$id/hold" | jq -r .id) && [[ "$hold" =~ ^[0-9a-f]+$ ]] ||
    { echo "lab fetch: could not hold job $id's files for the download" >&2; exit 1; }
  release() {
    [[ -z "$part" ]] || rm -f "$part"
    curl -fsS -o /dev/null -X DELETE "$url/jobs/$id/hold/$hold" || echo "lab fetch: hold $hold on job $id not released; it lapses on its own" >&2
  }
  trap release EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  hash_file() {
    local sum
    if command -v sha256sum >/dev/null 2>&1; then sum=$(sha256sum < "$1") || return 1
    elif command -v shasum >/dev/null 2>&1; then sum=$(shasum -a 256 < "$1") || return 1
    else return 1; fi
    printf '%s' "${sum%% *}"
  }
  note_missing() {
    missing+=$(jq -cn --arg path "$path" --argjson bytes "$bytes" --arg code "${code:-000}" \
      --argjson status "$curl_status" --argjson received "$received" --arg reason "$1" \
      --arg expected "${sha:-}" --arg actual "${got:-}" \
      '{path:$path,bytes:$bytes,httpStatus:$code,curlExit:$status,receivedBytes:$received,reason:$reason}
       + (if $expected == "" then {} else {expectedSha256:$expected,receivedSha256:$actual} end)')$'\n'
    echo "lab fetch: $path incomplete: $1" >&2
  }
  write_receipt() {
    printf '%s' "$missing" | jq -s --argjson job "$id" --argjson listed "$listed" \
      --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg url "$url" \
      '{job:$job,url:$url,fetchedAt:$at,listed:$listed,missing:.}' > "$receipt"
  }
  # JSON Lines preserve literal filenames; each URL component is encoded separately.
  listing=$(files_json "$id" | jq -c '.[]')
  listed=$(printf '%s\n' "$listing" | jq -s length)
  # A case-insensitive destination cannot retain two distinct accepted names that differ only by case.
  if printf '%s\n' "$listing" | jq -se 'group_by(.path | ascii_downcase) | any(.[]; length > 1)' >/dev/null; then
    probe=$(mktemp -d "$dest/.lab-fetch-case-XXXXXXXX")
    : > "$probe/a"
    if [[ -e "$probe/A" ]]; then
      rm -rf "$probe"
      path="" bytes=null code=000 curl_status=0 received=0 sha="" got=""
      note_missing destination-case-collision
      write_receipt
      echo 'lab fetch: these filenames require a case-sensitive destination' >&2
      exit 1
    fi
    rm -rf "$probe"
  fi
  renewed=$SECONDS
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    # A sentinel prevents command substitution from removing trailing newlines from a path.
    path=$(jq -jr '.path, "."' <<< "$entry"); path=${path%.}
    bytes=$(jq -r '.bytes' <<< "$entry"); sha=$(jq -r '.sha256 // ""' <<< "$entry")
    case "$path" in ''|/*|*/|*//*|*\\*|.|..|./*|../*|*/./*|*/../*|*/.|*/..) echo 'lab fetch: unsafe listed path' >&2; exit 1;; esac
    [[ "$bytes" =~ ^-?[0-9]+$ && ( -z "$sha" || "$sha" =~ ^[0-9a-f]{64}$ ) ]] ||
      { echo 'lab fetch: invalid file metadata' >&2; exit 1; }
    if (( SECONDS - renewed > 600 )); then
      curl -fsS -o /dev/null -X POST "$url/jobs/$id/hold/$hold" ||
        hold=$(curl -fsS -X POST "$url/jobs/$id/hold" | jq -r .id) ||
        echo "lab fetch: could not renew the hold on job $id" >&2
      renewed=$SECONDS
    fi
    got=""
    if [[ "$bytes" -ge 0 && -f "$dest/$path" && "$(wc -c < "$dest/$path")" -eq "$bytes" ]]; then
      if [[ -n "$sha" ]]; then got=$(hash_file "$dest/$path") || got=""; fi
      if [[ -z "$sha" || "$got" == "$sha" ]]; then verified+="$entry"$'\n'; continue; fi
    fi
    mkdir -p "$dest/$(dirname "$path")"
    part=$(mktemp "$dest/$(dirname "$path")/.lab-fetch-XXXXXXXX")
    encoded=$(jq -r '.path | split("/") | map(@uri) | join("/")' <<< "$entry")
    curl_status=0 got=""
    code=$(curl -sS -o "$part" -w '%{http_code}' "$url/jobs/$id/files/$encoded") || curl_status=$?
    received=$(wc -c < "$part" | tr -d '[:space:]')
    if [[ "$curl_status" -eq 0 && "$code" == 200 && ( "$bytes" -lt 0 || "$received" -eq "$bytes" ) ]]; then
      if [[ -n "$sha" ]]; then got=$(hash_file "$part") || got=""; fi
      if [[ -z "$sha" || "$got" == "$sha" ]]; then
        mv "$part" "$dest/$path"; verified+="$entry"$'\n'
      else note_missing checksum-mismatch; fi
    else note_missing incomplete-response; fi
    rm -f "$part"; part=""
  done <<< "$listing"
  # Rechecks can change these verdicts, so fetch them afresh rather than resuming the old export.
  part=$(mktemp "$dest/.lab-cases-XXXXXXXX")
  curl_status=0
  code=$(curl -fsS -o "$part" -w '%{http_code}' "$url/experiments/$id/cases.jsonl") || curl_status=$?
  if [[ "$curl_status" -eq 0 && "$code" == 200 ]]; then
    if [[ -s "$part" ]]; then mv "$part" "$dest/lab-cases.jsonl"; fi
  else
    received=$(wc -c < "$part" | tr -d '[:space:]')
    path=lab-cases.jsonl bytes=null sha="" got=""
    note_missing incomplete-response
  fi
  rm -f "$part"; part=""
  # A later write through a filesystem alias must not invalidate an earlier verified download silently.
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    sha=$(jq -r '.sha256 // ""' <<< "$entry"); [[ -n "$sha" ]] || continue
    path=$(jq -jr '.path, "."' <<< "$entry"); path=${path%.}
    bytes=$(jq -r '.bytes' <<< "$entry"); got="" received=0 code=200 curl_status=0
    if [[ -f "$dest/$path" ]]; then
      received=$(wc -c < "$dest/$path" | tr -d '[:space:]')
      got=$(hash_file "$dest/$path") || got=""
    fi
    if [[ "$got" != "$sha" ]]; then note_missing retained-checksum-mismatch; fi
  done <<< "$verified"
  if [[ -n "$missing" ]]; then
    write_receipt
    echo "lab fetch: job $id is incomplete: $(jq '.missing | length' "$receipt") downloads failed ($listed job files listed); see $receipt" >&2
    exit 1
  fi
  rm -f "$receipt" ;;
corpus) rsync -az --info=progress2 "$corpus/" "${host:?set LAB_HOST to the corpus server SSH destination}:$remote_corpus/" ;;
corpus-index)
  [[ $# -eq 1 && "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && ${#1} -le 200 ]] ||
    { echo 'usage: lab corpus-index <collection>' >&2; exit 2; }
  response=$(mktemp)
  transport=0
  code=$(curl -sS --max-time 45 -o "$response" -w '%{http_code}' "$url/corpus/indexes/$1") || transport=$?
  if [[ "$transport" -eq 0 && "$code" == 200 ]]; then
    status=0
    jq . "$response" || status=$?
  else
    cat "$response" >&2
    echo "lab corpus-index: metadata unavailable (HTTP $code, curl $transport)" >&2
    status=1
    # Only an explicit API index-missing response is an unpublished index; old servers also return 404.
    if [[ "$transport" -eq 0 && "$code" == 404 ]] &&
      jq -e --arg expected "no published corpus index for $1" '.error == $expected' "$response" >/dev/null 2>&1; then status=3; fi
  fi
  rm -f "$response"
  exit "$status" ;;
health) curl -fsS "$url/health" | jq . ;;
*) sed -n '2,/^set /{/^#/p}' "$0"; exit 2 ;;
esac
