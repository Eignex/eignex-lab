#!/usr/bin/env bash
# Client for the klause lab server. LAB_URL defaults to http://<LAB_HOST>:8420, LAB_HOST to 192.168.50.104.
#   lab run <experiment.json>                               queue an experiment: problems × configs × seeds, one case each
#                                                            one per question over all its problems, never batches; follow it with lab wait, lab cases
#   lab profile <main> <ref> <description> [host] [timeout-sec] [arg...]
#                                                            queue a profile job: the class <main> (in com.eignex.klause.bench.profile)
#                                                            run once with [arg...] in a build of <ref>, under JFR, locally
#                                                            or on a cloud node (on demand, never spot); [host] is ignored, the lab
#                                                            places jobs (pass - to skip it); for measurements experiments
#                                                            cannot express, NOT for running tests, lint or other gates (CI
#                                                            runs those). <ref> must be main or a branch only trusted users
#                                                            pushed to. [timeout-sec] is its time limit: 600 (10 min) when
#                                                            empty or left out, capped at 7200 (2 h); at it the main gets
#                                                            SIGTERM, then SIGKILL 30 s later, so it should write results
#                                                            as it goes or flush them on shutdown
#   lab analyze <id>                                        queue an analysis job: the lab's compilation analyser rerun over the
#                                                            retained captures of ended profileCli job <id>, writing each case's
#                                                            compilation-report.json afresh; no build, no solver, no klause code.
#                                                            Refused once the job was trimmed (a week after it ended)
#   lab cases <id>                                          an experiment's cases: status, arm, problem, result
#   lab csv <id> [arm] [seed]                               every case as CSV, or one arm's bench result table
#   lab references <text> [solver] [verdict]                find reference results; verdict: optimum unproven
#                                                            satisfied infeasible unknown
#   lab compare <id> <id>...                                the address of a page comparing experiments side by side
#   lab parallel <id> <n>                                    let a job run n commands at once, also while it runs
#   lab priority <id> <n>                                    reorder a queued job; a running one yields to a higher one
#   lab pause <id> | lab resume <id>                         hold a job; a running one stops between its commands
#   lab wait <id>...                                         block until every job given has ended; prints each end
#   lab schedule <name> <ref> <experiment.json> <interval-sec>   rerun the experiment on every new commit of <ref>
#   lab reschedule <id> <experiment.json|-> [interval-sec|-] [next-in-hours]
#                                                            change a schedule's experiment, interval or next check
#   lab schedules | lab unschedule <id>
#   lab check <id>                                          check a schedule's ref now instead of at its next interval
#   lab launch <id>                                         queue a schedule's run now, even if its ref has not moved
#   lab ls | lab show <id> | lab cancel <id> | lab tail <id> [<n> [out|err]]
#                                                            cancel a wrong job, not a long one: the lab bounds runtime itself
#   lab update                                              update the lab now: between the running job's cases, not during one
#   lab docker-cleanup                                      prune old reference images and build cache now: between jobs
#   lab host <id> local|cloud|auto                          operators only: override where a queued, unplanned job may run
#                                                            (the lab places every job itself; agents need not); lab and
#                                                            aws, the older names of local and cloud, still work
#   lab machines <id> [n]                                    retired: the cloud node pool sizes itself; the lab ignores it
#   lab node start [size] [spot|on-demand]                   start a cloud node now, past the pressure threshold: the size the
#                                                            queue calls for and spot first unless given (e.g. c7i.4xlarge);
#                                                            it takes work as any node and retires after nodeIdleMin idle
#   lab describe <id> <text>                                 set or change what an experiment is for
#   lab retry <id>...                                       queue a failed or cancelled job again: its unfinished cases rerun
#   lab rm <id>...                                          delete ended jobs: their records, files and leftover worktrees
#   lab files <id>                                           list a job's files: its log, setup log, records, case output
#   lab cat <id> <path> [tail-bytes]                         print one of them (job.log, setup.log, cases/<n>/record.json…)
#   lab fetch <id> [dest]                                    download the job's output directory over HTTP
#   lab corpus                                               rsync the local bench corpus to the server
# The lab asks for its password on every call: LAB_PASSWORD, or ~/.config/klause-lab/password.
#   lab ssh <id> [n] [command...]                            a shell (or command) on node n (default 0) of those working on a
#                                                            running cloud job (an AWS instance), through the server with the
#                                                            lab's own key and host keys
set -euo pipefail
host="${LAB_HOST:-192.168.50.104}"
url="${LAB_URL:-http://$host:8420}"
# Every call carries the lab's password (HTTP Basic, no user name): LAB_PASSWORD, else the file LAB_PASSWORD_FILE,
# ~/.config/klause-lab/password by default. It reaches curl through a private config file, never its command line.
password="${LAB_PASSWORD:-$(cat "${LAB_PASSWORD_FILE:-$HOME/.config/klause-lab/password}" 2>/dev/null || true)}"
curl() {
  [[ -n "$password" ]] || { echo "no lab password: set LAB_PASSWORD or put it in ~/.config/klause-lab/password" >&2; exit 2; }
  local auth status=0
  auth="$(umask 077; mktemp)"
  printf 'user = ":%s"\n' "$password" > "$auth"
  command curl -K "$auth" "$@" || status=$?
  rm -f "$auth"
  return "$status"
}
data="${LAB_REMOTE_DATA:-klause-lab-data}"
corpus="${LAB_CORPUS:-$HOME/.cache/klause-bench/corpus}"
cmd="${1:-ls}"; shift || true
case "$cmd" in
run) curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @"$1" "$url/experiments"; echo ;;
profile)
  [[ $# -ge 3 ]] || { echo "usage: lab profile <main> <ref> <description> [host, ignored] [timeout-sec, default 600, at most 7200] [arg...]" >&2; exit 2; }
  main="$1" ref="$2" description="$3" timeout="${5:-}"
  shift $(( $# < 5 ? $# : 5 ))
  [[ -z "$timeout" || "$timeout" =~ ^[1-9][0-9]*$ ]] || { echo "timeout-sec must be a positive number of seconds (default 600, at most 7200)" >&2; exit 2; }
  name="profile-$(echo "${main##*.}" | tr '[:upper:]' '[:lower:]')"
  # No timeout leaves the lab's default, 10 min; the lab caps any limit at 2 h. [host] is read for older callers and
  # not sent: the lab places every job itself.
  jq -n --arg name "$name" --arg main "$main" --arg ref "$ref" --arg description "$description" \
    --arg timeout "${timeout:+$(( timeout * 1000 ))}" --args \
    '{name: $name, description: $description, profile: {main: $main, args: $ARGS.positional},
      base: ({ref: $ref} + (if $timeout == "" then {} else {timeout: $timeout} end))}' "$@" |
    curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/experiments"; echo ;;
script) echo "lab script is retired: the lab runs only committed code; use lab profile <main> <ref> <description>" >&2; exit 2 ;;
analyze)
  [[ "${1:-}" =~ ^[1-9][0-9]*$ ]] || { echo "usage: lab analyze <job id>" >&2; exit 2; }
  jq -n --argjson job "$1" '{analyze: {job: $job, kind: "compilation"}}' |
    curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/experiments"; echo ;;
cases) curl -fsS "$url/experiments/$1/cases" | jq -r '.[] | [.index, .status, .arm, (if .problem.suite == "" then .problem.problem else "\(.problem.suite)/\(.problem.problem)" end),
      (.seed // "-"), (if .record == null then "-" else
        "feasible=\(.record.feasible) objective=\(.record.objective) proven=\(.record.proven) best=\(.record.timeToBestMs)ms" end)] | @tsv' ;;
csv)
  if [[ -z "${2:-}" ]]; then curl -fsS "$url/experiments/$1/cases.csv"
  else curl -fsS -G "$url/experiments/$1/bench.csv" --data-urlencode "arm=$2" ${3:+--data-urlencode "seed=$3"}; fi ;;
references)
  curl -fsS -G "$url/references" --data-urlencode "q=$1" --data-urlencode "solver=${2:-}" \
    --data-urlencode "verdict=${3:-}" -H 'Accept: application/json' | jq -r '.[] |
    [.collection, .problem, .reference.solver, (.reference.feasible|tostring), (.reference.objective|tostring),
     (.reference.proven|tostring), "\(.reference.elapsedMs)ms/\(.reference.budgetMs)ms"] | @tsv' ;;
ls) curl -fsS "$url/jobs?limit=${1:-30}" | jq -r '.[] | [.id, .status,
      "\(.counts.done)/\(.counts.total)", "\(.counts.failed) failed", "x\(.parallel // 1)",
      "p\(.priority // 0)\(if .paused then " paused" else "" end)", .ref, .name] | @tsv' ;;
show) curl -fsS "$url/jobs/$1" | jq . ;;
cancel) curl -sS -X POST "$url/jobs/$1/cancel"; echo ;;
parallel) jq -n --argjson parallel "$2" '{parallel: $parallel}' |
  curl -sS -H 'Content-Type: application/json' --data-binary @- "$url/jobs/$1/parallel"; echo ;;
priority) jq -n --argjson priority "$2" '{priority: $priority}' |
  curl -sS -H 'Content-Type: application/json' --data-binary @- "$url/jobs/$1/priority"; echo ;;
wait)
  for id in "$@"; do
    while :; do
      # The server holds the request until the job ends; a dropped connection is simply retried.
      status=$(curl -fsS --max-time 660 "$url/jobs/$id/wait?timeoutSec=600" | jq -r .status) || { sleep 10; continue; }
      case "$status" in DONE | FAILED | CANCELLED) echo -e "$id\t$status"; break ;; esac
    done
  done ;;
schedule)
  jq -n --arg name "$1" --arg ref "$2" --argjson interval "$4" --slurpfile experiment "$3" \
    '{name: $name, ref: $ref, intervalSec: $interval, experiment: $experiment[0]}' |
    curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/schedules"; echo ;;
reschedule)
  # `-` for the experiment or the interval keeps it; next-in-hours sets when the schedule is next checked.
  experiment=null; [[ "${2:--}" != - ]] && experiment=$(cat "$2")
  interval="${3:--}"; [[ "$interval" == - ]] && interval=null
  next=null; [[ -n "${4:-}" ]] && next=$(awk -v h="$4" 'BEGIN { printf "%d", h * 3600 }')
  jq -n --argjson interval "$interval" --argjson experiment "$experiment" --argjson next "$next" \
    '{intervalSec: $interval, experiment: $experiment, nextCheckInSec: $next}' |
    curl -sS --fail-with-body -H 'Content-Type: application/json' --data-binary @- "$url/schedules/$1"; echo ;;
compare) echo "$url/compare?jobs=$(IFS=,; echo "$*")" ;;
schedules) curl -fsS "$url/schedules" | jq -r '.[] | [.id, .name, .ref, "every \(.intervalSec)s", "p\(.priority)",
      "last \(.lastSha // "-" | .[0:9]) job \(.lastJob // "-")"] | @tsv' ;;
check) curl -sS --fail-with-body -X POST "$url/schedules/$1/check"; echo ;;
launch) curl -sS -X POST "$url/schedules/$1/launch"; echo ;;
update) curl -sS -X POST "$url/update"; echo ;;
docker-cleanup) curl -sS -X POST "$url/docker-cleanup"; echo ;;
host) jq -n --arg host "$2" '{host: $host}' |
  curl -sS -H 'Content-Type: application/json' --data-binary @- "$url/jobs/$1/host"; echo ;;
machines) jq -n --argjson machines "${2:-null}" '{machines: $machines}' |
  curl -sS -H 'Content-Type: application/json' --data-binary @- "$url/jobs/$1/machines"; echo ;;
describe) jq -n --arg description "${*:2}" '{description: $description}' |
  curl -sS -H 'Content-Type: application/json' --data-binary @- "$url/jobs/$1/description"; echo ;;
retry) for id in "$@"; do printf '%s\t' "$id"; curl -sS -X POST "$url/jobs/$id/retry"; echo; done ;;
rm) for id in "$@"; do printf '%s\t' "$id"; curl -sS -X POST "$url/jobs/$id/delete"; echo; done ;;
unschedule) curl -sS -X POST "$url/schedules/$1/delete"; echo ;;
pause) curl -sS -X POST "$url/jobs/$1/pause"; echo ;;
resume) curl -sS -X POST "$url/jobs/$1/resume"; echo ;;
tail)
  if [[ -z "${2:-}" ]]; then curl -fsS "$url/jobs/$1/files/job.log?tail=${TAIL_BYTES:-8000}"
  else curl -fsS "$url/jobs/$1/files/$2.${3:-out}?tail=${TAIL_BYTES:-8000}"; fi ;;
files) curl -fsS "$url/jobs/$1/files" | jq -r '.[] | "\(.bytes)\t\(.path)"' ;;
cat) curl -fsS "$url/jobs/$1/files/$2${3:+?tail=$3}" ;;
fetch)
  dest="${2:-lab-jobs/$1}"; mkdir -p "$dest"
  curl -fsS "$url/jobs/$1/files" | jq -r '.[] | "\(.path)\t\(.bytes)"' | while IFS=$'\t' read -r path bytes; do
    [[ -f "$dest/$path" && "$(wc -c < "$dest/$path")" -eq "$bytes" ]] && continue
    mkdir -p "$dest/$(dirname "$path")"
    curl -fsS -o "$dest/$path" "$url/jobs/$1/files/$path"
  done ;;
corpus) rsync -az --info=progress2 "$corpus/" "$host:.cache/klause-bench/corpus/" ;;
ssh) job="$1"; n="${2:-0}"; shift; shift || true
  # Instances are reached only from the server, which holds the key; their host keys are remembered by instance id,
  # since AWS hands a terminated instance's address to the next one.
  remote="cd $data/aws && id=\$(sed -n '$((n + 1))p' ../jobs/$job/aws-instances | cut -d' ' -f1) && [ -n \"\$id\" ] || { echo 'no such running instance' >&2; exit 1; }
    region=\$(sed -n 's/^region=//p' aws.properties); profile=\$(sed -n 's/^profile=//p' aws.properties)
    ip=\$(PATH=/opt/homebrew/bin:\$PATH aws --profile \$profile --region \$region ec2 describe-instances --instance-ids \$id --query 'Reservations[0].Instances[0].PublicIpAddress' --output text)
    exec ssh -i klause-lab.pem -o UserKnownHostsFile=known_hosts -o StrictHostKeyChecking=accept-new -o CheckHostIP=no \
      -o HostKeyAlias=klause-lab-\$region-\$id ubuntu@\$ip $(printf '%q ' "$@")"
  if [[ $# -eq 0 ]]; then exec ssh -t "$host" "$remote"; else exec ssh "$host" "$remote"; fi ;;
health) curl -fsS "$url/health" | jq . ;;
node)
  [[ "${1:-}" == start ]] || { echo "usage: lab node start [size] [spot|on-demand]" >&2; exit 2; }
  shift; size="" market=""
  for arg in "$@"; do case "$arg" in spot | on-demand) market="$arg" ;; *) size="$arg" ;; esac; done
  jq -n --arg size "$size" --arg market "$market" '{size: (if $size == "" then null else $size end), market: (if $market == "" then null else $market end)}' |
    curl -sS -H 'Content-Type: application/json' --data-binary @- "$url/cloud/nodes"; echo ;;
*) sed -n '2,/^set /{/^#/p}' "$0"; exit 2 ;;
esac
